ZEPGPU_SECRET_KEY=<at-least-32-random-characters>
POSTGRES_PASSWORD=<local-test-password>
COORDINATOR_PUBLIC_URL=http://localhost
COORDINATOR_DOMAIN=localhost
CORS_ORIGINS=http://localhost
VPN_RELAY_HOST=gpu.example.com
VPN_RELAY_PUBLIC_PORT=51820

# Managed service overrides (omit to use bundled Postgres and Redis):
# DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/zepgpu
# DATABASE_SYNC_URL=postgresql://user:password@db.example.com:5432/zepgpu
# REDIS_URL=rediss://default:password@redis.example.com:6379/0
# CELERY_BROKER_URL=rediss://default:password@redis.example.com:6379/1
# CELERY_RESULT_BACKEND=rediss://default:password@redis.example.com:6379/2
# CELERY_BEAT_SCHEDULE_DB=rediss://default:password@redis.example.com:6379/3
